    # Check that the matching R2 file exists
    if [[ ! -f "$file2" ]]; then
        echo "WARNING: Matching R2 file not found for $file1"
        continue
    fi

    # Extract sample name
    sample_name=$(basename "$file1" _R1_001_val_1.fq.gz)

    echo "Mapping $sample_name..."

    bwa mem -t 8 \
        GCA_031876335.1_mHipLar1.pri_genomic.fna \
        "$file1" \
        "$file2" \
        > "${sample_name}_aligned_reads.sam"

    if [[ $? -eq 0 ]]; then
        echo "Finished mapping $sample_name"
    else
        echo "ERROR: Mapping failed for $sample_name"
    fi

done


