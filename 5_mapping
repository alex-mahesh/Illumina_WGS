## creating sorted bam files for all sam files ##

for file in *.sam; do
    sample="${file%.sam}"

    echo "Processing $sample"

    # Add read groups
    samtools addreplacerg \
        -r "ID:${sample}" \
        -r "LB:${sample}" \
        -r "PL:ILLUMINA" \
        -r "PU:${sample}" \
        -r "SM:${sample}" \
        -o "${sample}_RG.bam" "$file" || continue

    # Sort BAM by genomic coordinates
    samtools sort -@ 4 \
        -o "${sample}_sorted.bam" \
        "${sample}_RG.bam" || continue

    # Remove intermediate BAM only after successful sorting
    rm "${sample}_RG.bam"

    echo "Completed $sample"
done


## marking and removing the duplicates ##

for file in *_sorted.bam; do
    base=${file%_sorted.bam}

    gatk MarkDuplicates \
        -I "$file" \
        -O "${base}_sorted_deduplicated.bam" \
        -M "${base}_duplication_metrics.txt" \
        --REMOVE_DUPLICATES true
done

## indexing the depulicated bam ##

for bam in *_deduplicated.bam; do
    [ -f "$bam" ] || continue
    echo "Indexing $bam ..."
    samtools index "$bam"
done

## estimating coverage ##

for file in *_aligned_reads_sorted_deduplicated.bam; do
    base=${file%_aligned_reads_sorted_deduplicated.bam}

    qualimap bamqc \
        -bam "$file" \
        -outdir "qualimap_results_${base}" \
        -outformat HTML \
        --java-mem-size=8G \
        -nt 8
done

