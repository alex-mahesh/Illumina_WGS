### mapping the reads on to the reference genome ###
## attaching back to a screen ##
tmux attach -t screen_1

## to exit from a screen (not to close it permennantly) ##
press (Ctrl + B) together and then D

conda activate bwa

for file1 in ../3_trimmed/*_R1_001_val_1.fq.gz; do

    file2=${file1/_R1_001_val_1.fq.gz/_R2_001_val_2.fq.gz}

    sample_name=$(basename "$file1" _R1_001_val_1.fq.gz)

    echo "Mapping $sample_name..."

    bwa mem \
        GCA_031876335.1_mHipLar1.pri_genomic.fna \
        "$file1" \
        "$file2" \
        > "${sample_name}_aligned_reads.sam"

done





