
################ applying the following filters- MinQ30, MinGQ30, remove indels, remove filtered all.################################

# Filter 1: Minimum variant quality (QUAL >= 30)
vcftools \
    --gzvcf genome.vcf.gz \
    --minQ 30 \
    --recode \
    --stdout | gzip -c > genome_MinQ30.vcf.gz


# Filter 2: Minimum genotype quality (GQ >= 30)
vcftools \
    --gzvcf genome_MinQ30.vcf.gz \
    --minGQ 30 \
    --recode \
    --stdout | gzip -c > genome_MinQ30_MinGQ30.vcf.gz


# Filter 3: Remove indels and retain SNPs only
vcftools \
    --gzvcf genome_MinQ30_MinGQ30.vcf.gz \
    --remove-indels \
    --recode \
    --stdout | gzip -c > genome_MinQ30_MinGQ30_SNPs.vcf.gz


# Filter 4: Retain only variants marked PASS
vcftools \
    --gzvcf genome_MinQ30_MinGQ30_SNPs.vcf.gz \
    --remove-filtered-all \
    --recode \
    --stdout | gzip -c > genome_MinQ30_MinGQ30_SNPs_PASS.vcf.gz

############################################################################################################################

# 1. Retain variants with QUAL >= 30
bcftools view -i 'QUAL>=30' variants.vcf.gz -Oz -o variants_MinQ30.vcf.gz

# 2. Mask genotypes with GQ < 30
bcftools filter -S . -e 'FMT/GQ<30' variants_MinQ30.vcf.gz -Oz -o variants_MinQ30_MinGQ30.vcf.gz

# 3. Retain SNPs only (remove indels)
bcftools view -v snps variants_MinQ30_MinGQ30.vcf.gz -Oz -o variants_MinQ30_MinGQ30_SNPsOnly.vcf.gz

# 4. Retain variants marked PASS
bcftools view -f PASS variants_MinQ30_MinGQ30_SNPsOnly.vcf.gz -Oz -o variants_MinQ30_MinGQ30_SNPsOnly_PASS.vcf.gz

# 5. Index the final VCF
bcftools index variants_MinQ30_MinGQ30_SNPsOnly_PASS.vcf.gz

echo "All filters applied successfully!"








