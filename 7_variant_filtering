
################ applying the following filters- MinQ30, MinGQ30, remove indels, remove filtered all.################################
// I have the following file- variants.vcf.gz file with me. I will be applying the filters on this file.


# 1. Retain variants with QUAL >= 30
bcftools view -i 'QUAL>=30' variants.vcf.gz -Oz -o variants_MinQ30.vcf.gz

# 2. Mask genotypes with GQ < 30
bcftools filter -S . -e 'FMT/GQ<30' variants_MinQ30.vcf.gz -Oz -o variants_MinQ30_MinGQ30.vcf.gz

# 3. Retain SNPs only (remove indels)
bcftools view -v snps variants_MinQ30_MinGQ30.vcf.gz -Oz -o variants_MinQ30_MinGQ30_SNPsOnly.vcf.gz

# 4. Retain variants marked PASS
bcftools view -f PASS variants_MinQ30_MinGQ30_SNPsOnly.vcf.gz -Oz -o variants_MinQ30_MinGQ30_SNPsOnly_PASS.vcf.gz

# 5. Index the final VCF
bcftools index variants_MinQ30_MinGQ30_SNPsOnly_PASS.vcf.gz

echo "All filters applied successfully!"


################# counting the number of variants in the above vcf file ###########################

zgrep -vc "^#" variants_MinQ30_MinGQ30_SNPsOnly_PASS.vcf.gz
// 126,629,336 - the number of variants in the above vcf file

####################### applying mac3 filter to the "filtered_strelka.vcf" file using vcf tools. #############################

vcftools --gzvcf variants_MinQ30_MinGQ30_SNPsOnly_PASS.vcf.gz \
--mac 3 \
--recode \
--recode-INFO-all \
--out variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3

// variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3.recode.vcf - this file gets created.
21,995,998 - the number of variants in the above vcf file
######################################################################################################################################################################
### applying the "hwe-0.05" filter
I am doing this combined for all the species

vcftools \
--vcf variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3.recode.vcf \
--hwe 0.05 \
--recode \
--out variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5

// filtered_mac3_hwe.recode.vcf - this vcf file will be created
// After filtering, kept 8210183 out of a possible 21995998 Sites

################################################################# Apply the individual missingness filter ##################################################

vcftools --vcf  variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5.recode.vcf --missing-indv
// out.imiss  out.log - these two files get created.
After filtering, kept 20 out of 20 Individuals
Outputting Individual Missingness
After filtering, kept 8210183 out of a possible 8210183 Sites

############################# Removing individuals which have missing proportion greater than 60 percent.##################################

vcftools --vcf variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5.recode.vcf \
 --remove <(awk '$5 > 0.6 {print $1}' out.imiss) --recode --out variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5_imiss_0.6

