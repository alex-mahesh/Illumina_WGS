################## Apply a missingness filter (max-missing) to only keep variants which are common among a proportion of individuals ####################################
## Do a for loop to apply missingness filter from 0.1 to 0.9 (variants which are found in 10% to 90%)

for miss in {10..90..10}; do

  perc=$(echo "scale=2; $miss / 100" | bc)

  echo "Running max-missing = $perc"

  vcftools --vcf variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5_imiss_0.9.recode.vcf \
           --max-missing $perc \
           --out variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5_imiss_0.9_miss_${miss} \
           --recode

done
// we get a recode.vcf file for each of the missing value
// After filtering, kept 19837 out of a possible 8210183 Sites - what does this mean??

## Extract the number of variants remaining upon applying missingness filter from 0.1 to 0.9 and make a .txt file.

for miss in {10..90..10}; do
    count=$(grep -vc "^#" variants_MinQ30_MinGQ30_SNPsOnly_PASS_mac3_hwe0.5_imiss_0.9_miss_${miss}.recode.vcf)
    echo "${miss} ${count}" >> variant_counts.txt
done
